<?xml version="1.0" encoding="utf-8"?>
<!--
    Podaci ostaju samo na ovom uređaju (lokalni model privatnosti).
    allowBackup="false" gasi cloud backup; prenos na novi telefon (Android 12+)
    ide po ovim pravilima, pa se i on isključuje: stara stanja (alarmi u direct
    boot skladištu, sesije, buđenje) ne smeju da se vrate na drugi uređaj.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
